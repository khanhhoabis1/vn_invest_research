{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vn-invest.local/schemas/task.schema.json",
  "title": "Task (TASK) - Goi thuc thi tu du cho AI",
  "description": "Don vi lam viec NGUYEN TU. Mot model AI nho (3B) doc file nay la du de thuc thi, KHONG can doc ca repo.",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "req_id",
    "comp_id",
    "created",
    "intent",
    "files_to_touch",
    "acceptance",
    "verify_commands",
    "context_budget_tokens"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "in_progress",
        "in_review",
        "done",
        "blocked",
        "cancelled"
      ]
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "req_id": {
      "type": "string",
      "pattern": "^REQ-[0-9]{4}$"
    },
    "comp_id": {
      "type": "string",
      "pattern": "^COMP-[0-9]{4}$"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{4}$"
      }
    },
    "intent": {
      "type": "string",
      "minLength": 20,
      "maxLength": 900,
      "description": "Mo ta chinh xac phai lam gi, viet cho model AI doc, ro rang khong an du"
    },
    "files_to_touch": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "action"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "action": {
            "enum": [
              "create",
              "modify",
              "delete",
              "read-only"
            ]
          },
          "hint": {
            "type": "string",
            "description": "Sua cho nao, ham nao"
          }
        }
      },
      "description": "AI CHI duoc sua nhung file nay"
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tuyet doi khong duoc dung vao (vd: data/bronze/**, .env)"
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Chu ky ham/endpoint phai tuan thu chinh xac"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "verify_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Lenh shell chay de chung minh task xong. Phai chay that."
    },
    "context_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Duong dan tai lieu/chunk can doc truoc. Giu it, chi cai thuc su can."
    },
    "context_budget_tokens": {
      "type": "integer",
      "minimum": 200,
      "maximum": 8000,
      "description": "Uoc luong token can de lam task. >6000 phai che nho task."
    },
    "model_hint": {
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "description": "small = 3B lam duoc; large = can model manh"
    },
    "estimate_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 480
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": "integer"
        },
        "pr": {
          "type": "integer"
        },
        "branch": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "verify_output": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}