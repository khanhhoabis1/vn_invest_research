# VN Invest Research Platform — bien moi truong
# Copy sang .env:  cp .env.example .env

POSTGRES_USER=vnir
POSTGRES_PASSWORD=vnir_local_dev
POSTGRES_DB=vnir
DB_PORT=5433

API_PORT=8000
UI_BUILD_PORT=8601
UI_OPS_PORT=8602
QDRANT_PORT=6333
OLLAMA_PORT=11434

VNIR_ROOT=/workspace
TZ=Asia/Ho_Chi_Minh

# User-Agent dinh danh khi thu thap du lieu (lich su voi nguon)
VNIR_USER_AGENT=vn-invest-research/0.1 (nghien cuu ca nhan)

# GitHub (tuy chon — de ghsync tao issue/PR). De trong neu dung `gh` tren host.
GITHUB_REPO=khanhhoabis1/vn_invest_research

# LLM cuc bo (profile ai). De trong = tat tinh nang phan ra tu dong.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
